# Maintainer: LXC Hotplug Team
pkgname=lxc-hotplug-guest
pkgver=1.0.0
pkgrel=1
pkgdesc="LXC USB Hotplug Guest Agent for Privileged Arch Linux Containers"
arch=('any')
url="https://github.com/forumi0721/lxc_hotplug"
license=('MIT')
depends=('python')
install=lxc-hotplug-guest.install
backup=('etc/lxc-hotplug/guest.yaml')

package() {
    # Install Python modules
    install -d "$pkgdir/opt/lxc_hotplug/src/lxc_hotplug"
    cp -r "$srcdir/../../../src/lxc_hotplug/common" "$pkgdir/opt/lxc_hotplug/src/lxc_hotplug/"
    cp -r "$srcdir/../../../src/lxc_hotplug/guest" "$pkgdir/opt/lxc_hotplug/src/lxc_hotplug/"
    install -m 644 "$srcdir/../../../src/lxc_hotplug/__init__.py" "$pkgdir/opt/lxc_hotplug/src/lxc_hotplug/"
    install -m 644 "$srcdir/../../../src/lxc_hotplug/__main__.py" "$pkgdir/opt/lxc_hotplug/src/lxc_hotplug/"

    # Install configuration & hooks
    install -d "$pkgdir/etc/lxc-hotplug/hooks.d"
    install -m 644 "$srcdir/../../../config/guest.yaml.example" "$pkgdir/etc/lxc-hotplug/guest.yaml"

    # Install systemd service
    install -d "$pkgdir/usr/lib/systemd/system"
    install -m 644 "$srcdir/../../../systemd/lxc-hotplug-guest.service" "$pkgdir/usr/lib/systemd/system/lxc-hotplug-guest.service"
}
