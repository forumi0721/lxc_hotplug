#!/sbin/openrc-run
name="lxc-hotplug-guest"
description="LXC USB Hotplug Guest Agent"

command="/usr/bin/python3"
command_args="-m lxc_hotplug guest --config /etc/lxc-hotplug/guest.yaml"
command_background="yes"
directory="/opt/lxc_hotplug"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.err"

export PYTHONPATH="/opt/lxc_hotplug/src"

depend() {
    need localmount
}
