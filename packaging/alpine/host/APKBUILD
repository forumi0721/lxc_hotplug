# Contributor: LXC Hotplug Team
# Maintainer: LXC Hotplug Team
pkgname=lxc-hotplug-host
pkgver=1.0.0
pkgrel=0
pkgdesc="LXC USB Hotplug Host Agent for Proxmox / Alpine Linux"
url="https://github.com/forumi0721/lxc_hotplug"
arch="noarch"
license="MIT"
depends="python3"
install=""
subpackages=""
source="lxc-hotplug-host.initd"

package() {
    # Install Python modules
    install -d "$pkgdir/opt/lxc_hotplug/src/lxc_hotplug"
    cp -r "$startdir/../../../src/lxc_hotplug/common" "$pkgdir/opt/lxc_hotplug/src/lxc_hotplug/"
    cp -r "$startdir/../../../src/lxc_hotplug/host" "$pkgdir/opt/lxc_hotplug/src/lxc_hotplug/"
    install -m 644 "$startdir/../../../src/lxc_hotplug/__init__.py" "$pkgdir/opt/lxc_hotplug/src/lxc_hotplug/"
    install -m 644 "$startdir/../../../src/lxc_hotplug/__main__.py" "$pkgdir/opt/lxc_hotplug/src/lxc_hotplug/"

    # Install configuration
    install -d "$pkgdir/etc/lxc-hotplug"
    install -m 644 "$startdir/../../../config/host.yaml.example" "$pkgdir/etc/lxc-hotplug/host.yaml.example"

    # Install OpenRC init service
    install -d "$pkgdir/etc/init.d"
    install -m 755 "$srcdir/lxc-hotplug-host.initd" "$pkgdir/etc/init.d/lxc-hotplug-host"
}
